# Only the dashboard needs to ship. The analysis modules are large (the ML
# module alone is ~180 MB with the trained model) and are never fetched by
# the browser.

Machine Learning & Prediction/
Remote Sensing & Data Engineering/
Decision-Support/
graphify-out/
.claude/

# The dashboard reads frontend/data/grid.geojson; the mock is only a local
# fallback and would otherwise ship a second copy of the whole grid.
frontend/mock_data/

*.qgz
*.pkl
*.ipynb
__pycache__/

# Generated deck - large binary, not needed by the browser
*.pptx

# The deck generator and its diagram. The previous presentation/ folder was
# deleted (8e6ba44) because it shipped ~4.3 MB of screenshots into every
# deployment; excluding it here is what keeps that from happening again.
presentation/
