{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/dashboard/", "destination": "/frontend/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/frontend/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, no-cache, must-revalidate" }
      ]
    }
  ]
}
